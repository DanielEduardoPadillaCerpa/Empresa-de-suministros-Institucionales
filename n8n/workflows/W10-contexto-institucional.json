    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first()?.json || {};\nconst known = new Set(['policia', 'defensa', 'bomberos', 'socorro', 'penitenciario', 'corporativo', 'general']);\nconst domains = {\n  'policia.gov.co': 'policia', 'policia.mil.co': 'policia',\n  'ejercito.mil.co': 'defensa', 'armada.mil.co': 'defensa',\n  'fac.mil.co': 'defensa', 'dimar.mil.co': 'defensa',\n  'mindefensa.gov.co': 'defensa', 'dnbc.gov.co': 'bomberos',\n  'bomberos.gov.co': 'bomberos', 'defensacivil.gov.co': 'socorro',\n  'defensacivil.org.co': 'socorro', 'inpec.gov.co': 'penitenciario'\n};\nconst email = typeof input.email === 'string' ? input.email.trim().toLowerCase() : '';\nconst requested = typeof input.institucion_id === 'string' ? input.institucion_id.trim().toLowerCase() : '';\nconst domain = email.includes('@') ? email.split('@').pop() : '';\nconst institution = known.has(requested) ? requested : (domains[domain] || 'corporativo');\nconst contexts = {\n  policia: { tema: 'policia', ruta_catalogo: '/index.html?vertical=policia', token_env: 'TENANT_POLICIA_ACCESS_TOKEN' },\n  defensa: { tema: 'defensa', ruta_catalogo: '/index.html?vertical=defensa', token_env: 'TENANT_DEFENSA_ACCESS_TOKEN' },\n  bomberos: { tema: 'bomberos', ruta_catalogo: '/index.html?vertical=bomberos', token_env: 'TENANT_BOMBEROS_ACCESS_TOKEN' },\n  socorro: { tema: 'socorro', ruta_catalogo: '/index.html?vertical=socorro', token_env: 'TENANT_SOCORRO_ACCESS_TOKEN' },\n  penitenciario: { tema: 'penitenciario', ruta_catalogo: '/index.html?vertical=penitenciario', token_env: 'TENANT_PENITENCIARIO_ACCESS_TOKEN' },\n  corporativo: { tema: 'corporativo', ruta_catalogo: '/index.html?vertical=corporativo', token_env: 'TENANT_CORPORATIVO_ACCESS_TOKEN' },\n  general: { tema: 'general', ruta_catalogo: '/index.html', token_env: null }\n};\nreturn [{ json: { institucion_id: institution, ...contexts[institution] } }];"
      },
      "id": "31000000-0000-4000-8000-000000000002",

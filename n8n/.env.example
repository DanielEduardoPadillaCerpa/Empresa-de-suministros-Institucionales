# Plantilla de n8n/.env. Los valores reales NO van en git: se llevan con el
# paquete de respaldar-n8n.ps1 (archivo n8n.env).
#
# N8N_ENCRYPTION_KEY debe ser la MISMA del computador original; si cambia,
# n8n no puede descifrar las credenciales guardadas (SMTP, etc.).
# Los N8N_W*_SECRET / *_TOKEN deben coincidir con los de backend/.env.
N8N_ENCRYPTION_KEY=
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota
EXECUTIONS_DATA_SAVE_ON_ERROR=none
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none

BACKEND_BASE_URL=http://host.docker.internal:8081
ASSISTANT_WEEKLY_SUMMARY_URL=http://host.docker.internal:8081/api/asistente/pendientes/resumen-semanal

ADMIN_EMAIL=
ADMIN_ALERT_TO=
ADMIN_ALERT_FROM=
MFA_FROM_EMAIL=
AUTOMATION_FROM_EMAIL=

N8N_W1_SECRET=
N8N_W2_DAILY_SUMMARY_TOKEN=
N8N_W3_SECRET=
N8N_W4_EXPIRY_TOKEN=
N8N_W6_ASSISTANT_ESCALATION_SECRET=
N8N_W8_ACCOUNT_SECRET=
ASSISTANT_WEEKLY_SUMMARY_TOKEN=
N8N_W11_SECRET=
N8N_W11_CALLBACK_SECRET=
N8N_W11_MAINTENANCE_TOKEN=

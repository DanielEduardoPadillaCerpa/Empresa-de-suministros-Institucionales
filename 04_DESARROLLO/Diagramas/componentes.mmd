        VER["routes/verificacion.js"]
        OTR["routes: clientes, miCuenta, asistente, atencion, reportes, misreportes, auditoria"]
        AUTZ["autorizacion.js y tenancy.js"]
        SEG["seguridad: cifradoCampos, captcha, padron, correo, contrasenas"]
        CRY["crypto.js y configSegura.js"]
        WRK["Workers: emailOutbox, automationOutbox, paymentJobs, verificacionJobs, sync padron"]

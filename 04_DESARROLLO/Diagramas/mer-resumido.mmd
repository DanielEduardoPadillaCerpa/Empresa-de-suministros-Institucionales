    clientes {
        int id PK
        varchar nit
        text nombre_funcionario "cifrado"
        varchar tipo_institucion
        enum estado_verificacion
        datetime verificado_hasta
    }
    usuarios {
        int id PK
        varchar correo UK
        varchar password_hash "bcrypt"
        enum rol "cliente o admin"
        enum estado_cuenta "pendiente activa rechazada suspendida"
        int session_version
        boolean es_superadmin
    }
    productos {
        int id PK
        varchar nombre
        decimal precio
        int cantidad_disponible
        boolean restringido
        varchar institucion_id
        enum revision_legal
    }
    pedidos {
        int id PK
        json items
        decimal total
        enum estado
    }
    pagos {
        bigint id PK
        varchar idempotency_key UK
        bigint monto_centavos
        enum estado
    }
    solicitudes_registro {
        bigint id PK
        char nit_hash "HMAC"
        text nit_cifrado
        enum resultado_verificacion
        enum estado
    }

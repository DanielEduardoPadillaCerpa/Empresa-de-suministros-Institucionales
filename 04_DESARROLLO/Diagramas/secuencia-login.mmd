%% DOC-04-DIA-04 · Secuencia de inicio de sesión con captcha y MFA · v1.0 · 2026-10-16 · BORRADOR
%% Fuente: backend/src/routes/auth.js, seguridad/captcha.js, seguridad/contrasenas.js, seguridad/correo.js
sequenceDiagram
    actor U as "Usuario"
    participant F as "login.html"
    participant A as "POST /api/auth"
    participant DB as "MySQL"
    participant M as "SMTP o consola laboratorio"
    U->>F: "abre login"
    F->>A: "GET /captcha"
    A-->>F: "id y svg, un solo uso, 5 min"
    U->>F: "correo, contrasena, resultado del captcha"
    F->>A: "POST /login"
    A->>A: "verificar captcha"
    A->>DB: "SELECT usuario por correo"
    A->>A: "bcrypt contra hash real o de relleno"
    alt "credenciales invalidas"
        A-->>F: "401 generico"
    else "cuenta no activa"
        A-->>F: "403 CUENTA_PENDIENTE, RECHAZADA o SUSPENDIDA"
    else "valida y activa"
        A->>DB: "lote: limite 5 retos por 15 min, inserta reto con HMAC del codigo"
        A-)M: "codigo de 6 digitos en segundo plano"
        A-->>F: "202 challengeId, expiresIn 300"
    end
    U->>F: "codigo recibido"
    F->>A: "POST /mfa/verificar"
    A->>DB: "SELECT reto FOR UPDATE con usuario y cliente"
    alt "codigo correcto, vigente, menos de 5 intentos"
        A->>DB: "reto verificado, refresh token hash, correo_verificado_en"
        A-->>F: "200 JWT 2 h, refresh 7 dias, rol, debeCambiarPassword"
        F->>F: "guarda sesion en localStorage"
    else "incorrecto"
        A-->>F: "401 con intentos restantes o 429 bloqueado"
    else "vencido"
        A-->>F: "410"
    end
